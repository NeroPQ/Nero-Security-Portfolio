---
import { ClientRouter } from 'astro:transitions';

const {
  title = 'Nero Security — Phan Thien Quang | SOC & Vulnerability Research Portfolio',
  description = 'Phan Thien Quang (Nero): Red Team / Blue Team cybersecurity portfolio featuring verified CVE reproductions, SIEM detection engineering, and HTB Academy / TryHackMe write-ups.',
  transitionStyle = 'scanline',
  ogImage = '/og-card.jpg',
  articleType = 'website',
} = Astro.props;

const path = Astro.url.pathname;
const siteOrigin = Astro.site ? Astro.site.origin : 'https://neropq.pages.dev';
const canonicalUrl = new URL(path, siteOrigin).href;
const ogImageUrl = new URL(ogImage, siteOrigin).href;

const navigation = [
  { href: '/', label: 'Home', index: 0 },
  { href: '/research/', label: 'Research', index: 1 },
  { href: '/projects/', label: 'Projects', index: 2 },
  { href: '/writeups/', label: 'Write-ups', index: 3 },
  { href: '/about/', label: 'About', index: 4 },
];
const active = (href: string) => href === '/' ? path === '/' : path.startsWith(href);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': articleType === 'article' ? 'TechArticle' : 'ProfilePage',
  name: title,
  description,
  url: canonicalUrl,
  image: ogImageUrl,
  author: {
    '@type': 'Person',
    name: 'Phan Thien Quang',
    alternateName: 'Nero',
    jobTitle: 'Cybersecurity Researcher & SOC Analyst Candidate',
    url: siteOrigin,
    sameAs: [
      'https://github.com/NeroPQ',
      'https://www.linkedin.com/in/phan-quang-nero/',
      'https://tryhackme.com/p/N3R0PH4N',
    ],
  },
};
---
<!doctype html>
<html lang="en" data-transition={transitionStyle}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Phan Thien Quang (Nero)" />
    <meta name="theme-color" content="#0d111a" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- OpenGraph / LinkedIn / Discord / Telegram -->
    <meta property="og:type" content={articleType} />
    <meta property="og:site_name" content="NERO.SEC // Phan Thien Quang" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Phan Thien Quang (Nero) — Red Team, Blue Team & Security Research Portfolio" />

    <!-- Twitter / X Large Summary Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <link rel="icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700;800&family=Press+Start+2P&family=Silkscreen:wght@400;700&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/styles.css" />
    <link rel="stylesheet" href="/writeups.css" />
    <title>{title}</title>
    <ClientRouter fallback="swap" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#page-top">Skip to content</a>
    <div class="cyber-progress" aria-hidden="true"></div>
    <div class="crt-overlay" aria-hidden="true"></div>

    <header class="main-header" transition:name="site-header">
      <div class="header-inner">
        <a class="brand" href="/">N<span>ERO.</span><small>ARCADE // SEC_OS</small></a>
        <nav aria-label="Primary navigation">
          {navigation.map(item => (
            <a
              href={item.href}
              data-nav-index={item.index}
              class:list={{ active: active(item.href) }}
              aria-current={active(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
        <div class="header-utilities">
          <button
            type="button"
            class="sfx-toggle"
            id="sfx-toggle"
            aria-pressed="false"
            aria-label="Toggle retro terminal audio effects"
          >
            SFX: OFF
          </button>
          <a class="header-link" href="https://github.com/NeroPQ" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </div>
      </div>
    </header>

    <main id="page-top" tabindex="-1" transition:name="page-canvas">
      <slot />
    </main>

    <footer class="main-footer" transition:name="site-footer">
      <div><strong>NERO.SEC // PIXEL_OS v2.6</strong><span>Research · Build · Document</span></div>
      <small>© <span id="year">2026</span> Phan Thien Quang · Educational research in authorized labs.</small>
      <a href="#page-top">Back to top ↑</a>
    </footer>

    <script is:inline>
      (() => {
        if (window.__neroRouterBound) return;
        window.__neroRouterBound = true;

        const routeIndex = (pathname) => {
          if (pathname === '/') return 0;
          if (pathname.startsWith('/research')) return 1;
          if (pathname.startsWith('/projects')) return 2;
          if (pathname.startsWith('/writeups')) return 3;
          if (pathname.startsWith('/about')) return 4;
          return 0;
        };

        document.addEventListener('astro:before-preparation', (event) => {
          const fromIdx = routeIndex(window.location.pathname);
          const toIdx = routeIndex(event.to.pathname);
          const dir = toIdx >= fromIdx ? 1 : -1;
          document.documentElement.style.setProperty('--nav-dir', String(dir));
          document.documentElement.classList.add('is-transitioning');
        });

        document.addEventListener('astro:after-swap', () => {
          const currentStyle = document.documentElement.getAttribute('data-transition') || 'scanline';
          document.documentElement.setAttribute('data-transition', currentStyle);
        });

        document.addEventListener('astro:page-load', () => {
          document.documentElement.classList.remove('is-transitioning');
        });
      })();
    </script>
    <script src="/site.js" defer></script>
  </body>
</html>
