{
  "name": "nero-security-portfolio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/astro-local.mjs dev",
    "build": "astro build --mode review && node scripts/verify-site.mjs dist review",
    "preview": "node scripts/astro-local.mjs preview",
    "check": "astro check && tsc --noEmit && node scripts/validate-writeups.mjs",
    "build:review": "astro build --mode review --config astro.review.config.mjs && node scripts/verify-site.mjs .review review",
    "preview:review": "node scripts/astro-local.mjs preview --mode review --config astro.review.config.mjs",
    "writeups": "node scripts/writeups.mjs",
    "validate:writeups": "node scripts/validate-writeups.mjs",
    "validate:site": "node scripts/verify-site.mjs",
    "test": "node --test tests/writeups.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "astro": "7.4.5",
    "entities": "^6.0.1",
    "github-slugger": "^2.0.0",
    "marked": "^15.0.12",
    "typescript": "^5.9.3",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5"
  }
}
